# Copy to .env and fill in the platforms you want to enable.

# Bluesky
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Mastodon (instance URL and an access token with write:statuses scope)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Reddit (script application credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=

# DEV
DEV_API_KEY=

# LinkedIn (member OAuth token and member URN)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
